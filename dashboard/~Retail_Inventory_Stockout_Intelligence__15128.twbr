      <column caption='Low Coverage Flag' datatype='integer' default-format='p0.00%' name='[Calculation_0347220752740352]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Inventory Coverage] &lt; 1 THEN 1&#13;&#10;ELSE 0&#13;&#10;END' />
